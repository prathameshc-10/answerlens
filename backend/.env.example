LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
# llama-3.2-90b-vision-preview has been decommissioned on Groq.
# Current vision model: https://console.groq.com/docs/vision
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GRADING_ENABLED=true
MAX_UPLOAD_MB=20
PORT=8000
# Optional: override where page PNGs are stored (defaults to the system temp dir)
# STORAGE_ROOT=/tmp
# PDF_DPI=175
